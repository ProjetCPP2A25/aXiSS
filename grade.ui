  <property name="styleSheet">
   <string>/* ===== GLOBAL STYLE ===== */
QWidget {
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    color: #1E293B;
}

QMainWindow, QDialog {
    background-color: #F1F5F9;
}

/* ===== SIDEBAR ===== */
QFrame#sidebar {
    background-color: #111C2E;
    border: none;
}

QLabel#appTitle {
    color: #FFFFFF;
    font-size: 19pt;
    font-weight: bold;
}

QLabel#appSubtitle {
    color: #94A3B8;
    font-size: 9pt;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#navButton,
QFrame#sidebar QPushButton {
    background-color: transparent;
    color: #CBD5E1;
    border: none;
    border-radius: 7px;
    padding: 11px 14px;
    text-align: left;
    font-size: 10pt;
}

QPushButton#navButton:hover,
QFrame#sidebar QPushButton:hover {
    background-color: #263449;
    color: white;
}

QPushButton#navButton:checked,
QFrame#sidebar QPushButton:checked {
    background-color: #D9363E;
    color: white;
    font-weight: bold;
}

/* ===== PAGE TITLE ===== */
QLabel#pageTitle {
    color: #142238;
    font-size: 22pt;
    font-weight: bold;
}

QLabel#pageSubtitle {
    color: #64748B;
    font-size: 10pt;
}

/* ===== STATISTICS CARDS ===== */
QFrame#statCard,
QFrame#statCard1,
QFrame#statCard2,
QFrame#statCard3,
QFrame#statCard4,
QFrame#statCardParticipation,
QFrame#selectedWorkshopCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QLabel#statTitle,
QLabel#statTitle1,
QLabel#statTitle2,
QLabel#statTitle3,
QLabel#statTitle4,
QLabel#statTitleParticipation {
    color: #64748B;
    font-size: 10pt;
}

QLabel#statValue,
QLabel#statValue1,
QLabel#statValue2,
QLabel#statValue3,
QLabel#statValue4,
QLabel#statValueParticipation {
    color: #142238;
    font-size: 24pt;
    font-weight: bold;
}

/* ===== INPUTS ===== */
QLineEdit, QComboBox, QDateEdit,
QTimeEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    padding: 9px;
    min-height: 18px;
    selection-background-color: #D9363E;
}

QLineEdit:focus, QComboBox:focus,
QDateEdit:focus, QTimeEdit:focus, QSpinBox:focus {
    border: 1px solid #D9363E;
}

QLineEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

/* ===== BUTTONS ===== */
QPushButton#primaryButton,
QPushButton#addButton {
    background-color: #D9363E;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    padding: 10px 18px;
    font-weight: bold;
}

QPushButton#primaryButton:hover,
QPushButton#addButton:hover {
    background-color: #B91C28;
}

QPushButton#secondaryButton,
QPushButton#detailsButton,
QPushButton#statsButton,
QPushButton#pdfButton,
QPushButton#recommendButton,
QPushButton#certButton,
QPushButton#btnPlanifierIntervention,
QPushButton#btnAttestation,
QPushButton#btnRappelEmail,
QPushButton#btnRetourClients1,
QPushButton#btnRetourClients2,
QPushButton#btnRetourClients3,
QPushButton#btnRetourClients4 {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    padding: 9px 16px;
    text-align: center;
}

QPushButton#secondaryButton:hover,
QPushButton#detailsButton:hover,
QPushButton#statsButton:hover,
QPushButton#pdfButton:hover,
QPushButton#recommendButton:hover,
QPushButton#certButton:hover,
QPushButton#btnPlanifierIntervention:hover,
QPushButton#btnAttestation:hover,
QPushButton#btnRappelEmail:hover,
QPushButton#btnRetourClients1:hover,
QPushButton#btnRetourClients2:hover,
QPushButton#btnRetourClients3:hover,
QPushButton#btnRetourClients4:hover {
    background-color: #F1F5F9;
}

QPushButton#dangerButton,
QPushButton#btnResilier {
    background-color: #FEE2E2;
    color: #B91C1C;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
}

QPushButton#dangerButton:hover,
QPushButton#btnResilier:hover {
    background-color: #FECACA;
}

/* ===== TABLE ===== */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #E2E8F0;
    selection-background-color: #FEE2E2;
    selection-color: #142238;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    font-weight: bold;
}

/* ===== STATUS BADGES ===== */
QLabel#activeStatus {
    background-color: #DCFCE7;
    color: #166534;
    border-radius: 5px;
    padding: 5px 8px;
    font-weight: bold;
}

QLabel#pendingStatus {
    background-color: #FEF3C7;
    color: #92400E;
    border-radius: 5px;
    padding: 5px 8px;
    font-weight: bold;
}

QLabel#completedStatus {
    background-color: #E2E8F0;
    color: #334155;
    border-radius: 5px;
    padding: 5px 8px;
    font-weight: bold;
}

QLabel#expiredStatus {
    background-color: #FEE2E2;
    color: #B91C1C;
    border-radius: 5px;
    padding: 5px 8px;
    font-weight: bold;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    background: #F1F5F9;
    width: 8px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ===== MODULE HUBCARDS ===== */
QFrame#moduleCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame#moduleCard:hover {
    border: 1px solid #D9363E;
}

QLabel#moduleTitle {
    color: #142238;
    font-size: 13pt;
    font-weight: bold;
}

QLabel#moduleDesc {
    color: #64748B;
    font-size: 9pt;
}

/* ===== RIGHT SIDEBAR AND MISC ===== */
QFrame#rightSidebar {
    background-color: #FFFFFF;
    border: none;
    border-left: 1px solid #E2E8F0;
}

QLabel#detailsTitle,
QLabel#quickTitle,
QLabel#listTitle {
    color: #142238;
    font-size: 13pt;
    font-weight: bold;
}

QLabel#tagline {
    color: #64748B;
    font-size: 9pt;
}

QLabel#adminLabel {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    padding: 6px 14px;
    font-weight: bold;
    color: #142238;
}

QLabel#selectedWorkshopTitle {
    color: #142238;
    font-size: 12pt;
    font-weight: bold;
}

QLabel#details {
    color: #334155;
    line-height: 1.5;
}
</string>
